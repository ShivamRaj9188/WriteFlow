# ─────────────────────────────────────────────────
# WriteFlow Backend – Local Development Environment
# ─────────────────────────────────────────────────
# This file is intentionally committed for local dev convenience.
# DO NOT put real production secrets here.

BLOG_JWT_SECRET=writeflow-local-dev-secret-key-must-be-at-least-32-chars
BLOG_JWT_EXPIRATION_MS=86400000

# Database — defaults to embedded H2, no config needed locally.
# Uncomment and fill in if you want to point at a real PostgreSQL instance:
# BLOG_DB_URL=jdbc:postgresql://localhost:5432/blogdb
# BLOG_DB_USERNAME=postgres
# BLOG_DB_PASSWORD=yourpassword

SERVER_PORT=8080
